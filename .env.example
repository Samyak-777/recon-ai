# ═══════════════════════════════════════════════════
# ReconAI — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════

# ── Razorpay API Credentials (Test Mode) ──────────
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Razorpay Webhook Secret (Optional) ────────────
# Configure at: Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ── MongoDB Connection ────────────────────────────
# Default: local MongoDB. For Atlas, use full connection string.
MONGODB_URI=mongodb://localhost:27017

# ── Google Gemini API Key (Optional) ──────────────
# Used for advanced Q&A agent. System works without it.
GEMINI_API_KEY=

# ── Environment ───────────────────────────────────
ENVIRONMENT=development
