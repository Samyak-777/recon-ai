{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://recon-ai-api.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://recon-ai-api.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
